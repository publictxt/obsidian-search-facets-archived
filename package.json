{
  "name": "publictxt-search",
  "version": "0.1.0",
  "description": "Obsidian plugin: full-text search with type and tag facets, mirroring the PublicTxt-Hugo search page.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --outfile=main.js --format=cjs --platform=node --target=es2022 --external:obsidian --sourcemap=inline --watch",
    "build": "esbuild src/main.ts --bundle --outfile=main.js --format=cjs --platform=node --target=es2022 --external:obsidian --minify",
    "check": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy.ps1"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
